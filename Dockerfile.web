FROM node:22.13.0-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build:web

FROM node:22.13.0-bookworm-slim AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    WRANGLER_LOG_PATH=/tmp/wrangler.log
WORKDIR /app
RUN groupadd --system dentamonitor && useradd --system --gid dentamonitor dentamonitor
COPY --from=build --chown=dentamonitor:dentamonitor /app/package.json ./package.json
COPY --from=build --chown=dentamonitor:dentamonitor /app/node_modules ./node_modules
COPY --from=build --chown=dentamonitor:dentamonitor /app/dist ./dist
COPY --from=build --chown=dentamonitor:dentamonitor /app/public ./public
COPY --from=build --chown=dentamonitor:dentamonitor /app/vite.config.ts ./vite.config.ts
USER dentamonitor
EXPOSE 3000
CMD ["./node_modules/.bin/vinext", "start"]
