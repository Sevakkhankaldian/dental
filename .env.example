# Runtime — safe local placeholders only
APP_ENV=local
APP_VERSION=dev
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
DEFAULT_LOCALE=fa-IR
DEFAULT_TIMEZONE=Asia/Tehran
LOG_LEVEL=info

# Database, cache, workflow and storage
DATABASE_URL=postgresql://dentamonitor:local-only@localhost:5432/dentamonitor
DATABASE_POOL_MAX=20
DATABASE_SSL=false
MIGRATE_ON_START=false
SEED_SYNTHETIC_DATA=false
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=dentamonitor-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_RAW_BUCKET=dm-raw-local
S3_DERIVED_BUCKET=dm-derived-local
S3_EXPORT_BUCKET=dm-export-local
UPLOAD_PART_SIZE_MB=8
SIGNED_URL_TTL_SECONDS=600

# Identity and crypto — references, never raw secrets
OIDC_ISSUER_URL=https://identity.example.test
OIDC_AUDIENCE=dentamonitor-api
OIDC_CLIENT_ID=local-client
KMS_KEY_ID=local-development-only
FIELD_ENCRYPTION_KEY_REF=secret://dentamonitor/field-key
AUDIT_SIGNING_KEY_REF=secret://dentamonitor/audit-key
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=dentamonitor-api
JWT_SECRET=local-only-jwt-secret-change-me-32-bytes
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
OTP_PHONE_PEPPER=local-only-phone-pepper-change-me
IP_HASH_PEPPER=local-only-ip-pepper-change-me-now
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_FIXED_CODE=123456

# Provider adapters
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=dentamonitor-login
KAVENEGAR_API_BASE_URL=https://api.kavenegar.com
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Base64-encoded service account JSON. Set as a Liara/GitHub secret; never commit the value.
FIREBASE_SERVICE_ACCOUNT_BASE64=
APNS_CREDENTIALS_REF=secret://dentamonitor/apns
NOTIFICATION_DEFAULT_FROM=DentaMonitor

# AI remains shadowed and patient-facing automation is disabled
MODEL_REGISTRY_URI=http://localhost:5000
INFERENCE_DEVICE=cpu
AI_DEFAULT_MODE=shadow
AI_GLOBAL_KILL_SWITCH=false
MODEL_ARTIFACT_SIGNING_REQUIRED=true
LLM_PROVIDER=disabled
LLM_CREDENTIALS_REF=secret://dentamonitor/llm

# Observability and feature configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=dentamonitor-api
METRICS_EXPORTER=otlp
FEATURE_FLAG_PROVIDER=local
FEATURE_FLAG_SDK_KEY_REF=secret://dentamonitor/flags
