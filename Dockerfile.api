FROM node:22.13.0-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build:api

FROM node:22.13.0-bookworm-slim AS runtime
ENV NODE_ENV=production \
    APP_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=4000
WORKDIR /app
RUN groupadd --system dentamonitor && useradd --system --gid dentamonitor dentamonitor
COPY --from=build --chown=dentamonitor:dentamonitor /app/package.json ./package.json
COPY --from=build --chown=dentamonitor:dentamonitor /app/node_modules ./node_modules
COPY --from=build --chown=dentamonitor:dentamonitor /app/dist-api ./dist-api
COPY --from=build --chown=dentamonitor:dentamonitor /app/packages/database/migrations ./packages/database/migrations
USER dentamonitor
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/v1/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist-api/apps/api/src/main.js"]
